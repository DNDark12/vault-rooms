# 127.0.0.1 only accepts connections from this machine. Other LAN machines
# cannot reach 127.0.0.1 (it always means "this computer" to them, no matter
# whose it is) and editing /etc/hosts does not change that. To let teammates
# on the same LAN connect, set HOST=0.0.0.0 to bind all interfaces, then
# share the printed "LAN:" URL / invite link (uses your real LAN IP) instead
# of the "Local:" one.
HOST=0.0.0.0
# PORT=8787
# If LAN IP auto-detection picks the wrong address (multiple adapters, VPNs,
# some Wi-Fi drivers), set the URL teammates should use in invite links.
# This is the standalone equivalent of the "Public URL override" setting.
# PUBLIC_URL=http://[IP_ADDRESS]
MAX_FILE_BYTES=5242880
# Ceiling on stored content bytes across all rooms - not the same as MAX_FILE_BYTES (a single
# payload) or the .sqlite file's own size (which only shrinks after an explicit reclaim/VACUUM).
MAX_STORED_CONTENT_BYTES=268435456
ALLOW_REMOTE_BOOTSTRAP=false
